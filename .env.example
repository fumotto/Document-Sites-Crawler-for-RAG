# NotebookLM Document Crawler 設定ファイル（07_CLI仕様.md 3節参照）
# このファイルを .env にコピーして使用してください。

# 複数サイトURL（改行区切り）。CLI引数でURLを指定した場合はこちらは無視されます。
BASE_URLS=https://example.com

# 差分更新モード: incremental（差分のみ取得） / full（全件再取得）
MODE=incremental

# 結合Markdown（docs_XXX.md）1ファイルあたりの語数上限
WORD_LIMIT=450000

# リクエスト間の待機秒数（サーバー負荷軽減のため）
REQUEST_DELAY=0.5

# HTTPアクセス時のUser-Agent
USER_AGENT=NotebookLM-Crawler/1.0

# 取得対象パス（カンマ区切り）。空の場合は制限なし。
INCLUDE=

# 除外対象パス（カンマ区切り）。空の場合は制限なし。
EXCLUDE=

# 同一ドメインクロール時の最大ページ数（ソフトリミット）。必須項目です。
MAX_PAGES=1000

# HTTPタイムアウト秒数。必須項目です。
TIMEOUT_SECONDS=30

# ログレベル: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ログフォーマット: text / json
LOG_FORMAT=text

# ログファイル出力先
LOG_FILE_PATH=logs/crawler.log
