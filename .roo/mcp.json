{
	"mcpServers": {
		"filesystem": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"${workspaceFolder}"
			],
			"env": {
				"FS_ROOT": "${workspaceFolder}"
			},
			"alwaysAllow": [
				"read_file",
				"read_media_file",
				"read_multiple_files",
				"write_file",
				"edit_file",
				"create_directory",
				"list_directory",
				"list_directory_with_sizes",
				"search_files",
				"move_file",
				"directory_tree",
				"get_file_info",
				"list_allowed_directories",
				"read_text_file"
			]
		},
		"tavily": {
			"command": "npx",
			"args": [
				"-y",
				"tavily-mcp@0.2.3"
			],
			"env": {
				"TAVILY_API_KEY": "${env:TAVILY_API_KEY}"
			},
			"alwaysAllow": [
				"tavily-search",
				"tavily-map"
			]
		},
		"context7": {
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp"
			],
			"env": {
				"DEFAULT_MINIMUM_TOKENS": ""
			},
			"alwaysAllow": [
				"resolve-library-id",
				"query-docs"
			],
			"disabledTools": []
		}
	}
}